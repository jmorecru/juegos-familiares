#!/bin/sh
# En cada commit:
#  - escribe en version.js el número de versión (commits + 1) y la fecha;
#  - en las páginas HTML, pone ?v=N en los ficheros propios que cargan (src="….js", href="….css") y en
#    los valores del mapa de importaciones ("…": "./js/….js"), para que el navegador no mezcle ficheros
#    guardados de versiones distintas (GitHub Pages permite guardarlos 10 minutos).
#    Las direcciones externas (https://…) no se tocan: el patrón no admite ":" en la ruta.
# Cambia el fichero y también lo preparado para el commit, sin añadir otros cambios no preparados.
# Se activa una vez por clon con: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
numero=$(( $(git rev-list --count HEAD 2>/dev/null || echo 0) + 1 ))
fecha=$(date '+%Y-%m-%d %H:%M')

# $1 fichero, $2 expresión de sed (-E)
actualizar() {
  sed -i -E "$2" "$1"
  entrada=$(git ls-files -s -- "$1")
  [ -n "$entrada" ] || { git add -- "$1"; return; }
  modo=${entrada%% *}
  blob=$(git show ":$1" | sed -E "$2" | git hash-object -w --stdin)
  git update-index --cacheinfo "$modo,$blob,$1"
}

ruta='[A-Za-z0-9_./-]+\.(js|css)'
actualizar version.js "s/^const VERSION = .*/const VERSION = { numero: $numero, fecha: '$fecha' };/"
for f in $(git ls-files '*.html'); do
  grep -qE "(src|href)=\"$ruta(\?v=[0-9]+)?\"|: *\"$ruta(\?v=[0-9]+)?\"" "$f" || continue
  actualizar "$f" "s#((src|href)=\")($ruta)(\?v=[0-9]+)?\"#\1\3?v=$numero\"#g; s#(: *\")($ruta)(\?v=[0-9]+)?\"#\1\2?v=$numero\"#g"
done
exit 0
